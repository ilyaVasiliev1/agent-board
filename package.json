{
  "name": "agent-board",
  "private": true,
  "type": "module",
  "description": "Доска облачных задач Claude: локальное управление и страница просмотра на сервере",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 5195 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node server/index.mjs",
    "serve": "node server/index.mjs",
    "test": "node --test 'test/*.test.mjs' && vitest run",
    "check": "tsc --noEmit && npm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
